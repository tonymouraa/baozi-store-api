          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "clientes"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"Tony5230010\",\n  \"clienteDesde\": \"2026-11-20\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
